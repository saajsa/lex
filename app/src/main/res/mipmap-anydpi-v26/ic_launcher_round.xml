<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background matches the foreground PNG padding (#F5F4F0) so parallax
         shift never exposes a colour seam at the edges.
         No <monochrome> layer: polarity is the brand wayfinder; opting out
         of system themed-icon recolouring. -->
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
