<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose handles theming. This XML theme is the splash/launch theme
         AND the parent for any AppCompat-based Activity our deps launch
         (such an Activity fails to inflate under a framework theme), so
         Theme.AppCompat is the parent rather than the framework theme. -->
    <style name="Theme.LegumLex" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Native (Android 12+) launch splash: client polarity — ink LJ on the
         snow background, then hands off to Theme.LegumLex once the activity
         is ready. Polarity matches the home-screen icon (snow tile) so the
         tap-to-open feels visually continuous. -->
    <style name="Theme.LegumLex.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.LegumLex</item>
    </style>
</resources>
