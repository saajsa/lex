<!--
  Status-bar notification icon. Must be a white silhouette on transparent
  per Android's notification icon contract — Android tints the silhouette
  to match the system theme. A solid colour fill would just appear as
  a white square on older API levels.

  The mark is a notched square matching the brand's "tab" mark in the
  launcher icon so the lockscreen notification reads as ours at a glance.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <path
        android:fillColor="@android:color/white"
        android:pathData="M5,3h14a2,2 0,0 1,2 2v14a2,2 0,0 1,-2 2H5a2,2 0,0 1,-2 -2V5a2,2 0,0 1,2 -2zM7,7v10h6v-3h4V7H7z" />
</vector>
